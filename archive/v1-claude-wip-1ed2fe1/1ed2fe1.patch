+/* POSTER HERO — dandelion field + original portrait cutout.
+   The portrait is not color-filtered, to preserve skin texture and avoid a plastic look. */
+.hero.poster-hero {
+  min-height:100svh;
+  padding:7rem 4rem 5rem;
+  background:#dfead7;
+  color:#183126;
+}
+.poster-field,
+.poster-grade,
+.poster-atmosphere,
+.poster-foreground,
+.hero-wind {
+  position:absolute;
+  inset:0;
+  pointer-events:none;
+}
+.poster-field {
+  z-index:0;
+  inset:-5vh -6vw;
+  background-image:var(--theme-hero-bg);
+  background-size:cover;
+  background-position:var(--theme-hero-bg-pos);
+  filter:saturate(0.98) contrast(0.96) brightness(1.02);
+  transform:scale(1.045);
+  will-change:translate;
+}
+.poster-grade {
+  z-index:1;
+  background:
+    radial-gradient(62% 52% at 80% 16%, rgba(255,246,210,0.48), transparent 68%),
+    linear-gradient(180deg, rgba(242,248,242,0.18) 0%, rgba(255,247,221,0.08) 42%, rgba(25,50,29,0.24) 100%),
+    linear-gradient(90deg, rgba(217,235,225,0.22), transparent 38%, transparent 72%, rgba(255,246,214,0.18));
+  mix-blend-mode:soft-light;
+}
+.poster-atmosphere {
+  z-index:2;
+  background:
+    linear-gradient(180deg, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.30) 34%, rgba(255,255,255,0.04) 58%, transparent 76%),
+    radial-gradient(70% 38% at 54% 52%, rgba(255,246,210,0.22), transparent 72%);
+}
+.hero-wind {
+  z-index:8;
+  width:100%;
+  height:100%;
+  mix-blend-mode:screen;
+}
+.hero.poster-hero .hero-wind {
+  opacity:0.95;
+}
+.poster-foreground {
+  z-index:9;
+  top:auto;
+  height:26vh;
+  background-image:
+    linear-gradient(180deg, transparent 0%, rgba(20,48,20,0.08) 34%, rgba(17,42,20,0.46) 100%),
+    var(--theme-hero-bg);
+  background-size:cover, 126vw auto;
+  background-position:center, center bottom;
+  transform-origin:center bottom;
+  filter:saturate(1.05) contrast(1.02);
+  -webkit-mask-image:linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.1) 12%, rgba(0,0,0,0.8) 34%, #000 100%);
+  mask-image:linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.1) 12%, rgba(0,0,0,0.8) 34%, #000 100%);
+  will-change:translate;
+}
+.hero-person-wrap {
+  position:absolute;
+  z-index:6;
+  right:clamp(5rem, 12vw, 16rem);
+  bottom:-10vh;
+  width:min(47vw, 780px);
+  min-width:560px;
+  opacity:0;
+  animation:heroPhotoIn 1.5s cubic-bezier(0.2,0.7,0,1) 0.15s both;
+  filter:drop-shadow(0 28px 54px rgba(23,42,25,0.28));
+  transform-origin:50% 100%;
+  will-change:translate;
+}
+.hero-person-wrap.loaded { opacity:1; }
+.hero-person-wrap::before {
+  content:'';
+  position:absolute;
+  inset:8% -5% 6% -5%;
+  border-radius:50%;
+  background:radial-gradient(closest-side, rgba(255,247,218,0.28), transparent 72%);
+  filter:blur(22px);
+  transform:translate(5%, -7%);
+  z-index:-1;
+}
+.hero-person {
+  display:block;
+  width:100%;
+  height:auto;
+  -webkit-mask-image:linear-gradient(to bottom, #000 0%, #000 84%, rgba(0,0,0,0.84) 92%, transparent 100%);
+  mask-image:linear-gradient(to bottom, #000 0%, #000 84%, rgba(0,0,0,0.84) 92%, transparent 100%);
+}
+.poster-hero .hero-tint {
+  z-index:3;
+  background:
+    radial-gradient(42% 48% at 18% 52%, rgba(255,250,226,0.5), rgba(255,250,226,0.2) 42%, transparent 74%),
+    linear-gradient(to top, rgba(9,8,14,0.2) 0%, rgba(9,8,14,0.04) 30%, transparent 58%);
+}
+.poster-hero .hero-vignette {
+  z-index:4;
+  background:radial-gradient(120% 100% at 54% 42%, transparent 58%, rgba(31,43,28,0.25) 100%);
+}
+.poster-hero .hero-side {
+  z-index:10;
+  color:rgba(31,49,37,0.42);
+}
+.poster-hero .hero-content {
+  z-index:10;
+  max-width:min(540px, 38vw);
+  padding:0;
+  background:none;
+  -webkit-backdrop-filter:none;
+  backdrop-filter:none;
+  text-shadow:0 2px 26px rgba(255,250,225,0.96), 0 1px 0 rgba(255,250,225,0.42);
+}
+.poster-hero .hero-eyebrow {
+  color:rgba(35,58,42,0.68);
+}
+.poster-hero .hero-name {
+  color:color-mix(in srgb, var(--theme-ink) 96%, #000);
+  font-size:calc(clamp(5rem,9.2vw,9.8rem) * var(--hero-scale, 1));
+  line-height:0.86;
+}
+.poster-hero .hero-name .line2 {
+  color:color-mix(in srgb, var(--theme-leaf) 90%, #1a2619);
+}
+.poster-hero .hero-roles,
+.poster-hero .hero-quote,
+.poster-hero .hero-manifesto {
+  color:rgba(14,34,24,0.9);
+}
+.poster-hero .hero-quote {
+  border-left-color:rgba(79,99,54,0.62);
+  background:linear-gradient(90deg, rgba(255,250,226,0.42), rgba(255,250,226,0.12) 58%, transparent 100%);
+  padding:0.45rem 0 0.45rem 1.25rem;
+  max-width:330px;
+}
+.poster-hero .hero-manifesto {
+  max-width:360px;
+}
+.poster-hero .counter-num {
+  color:var(--theme-leaf);
+}
+.poster-hero #typewriter-cursor {
+  background:var(--theme-leaf);
+}
+.poster-hero .scroll-hint {
+  z-index:10;
+}
+.poster-hero .scroll-hint span {
+  color:rgba(31,49,37,0.42);
+}
+.poster-hero .scroll-line {
+  background:linear-gradient(to bottom, rgba(81,106,57,0.62), transparent);
+}
+
+/* SEASON SKIN — decorative layer only. Content structure remains independent. */
+body:not(.no-season) section:not(.hero) {
+  position:relative;
+  isolation:isolate;
+}
+body:not(.no-season) section:not(.hero)::after {
