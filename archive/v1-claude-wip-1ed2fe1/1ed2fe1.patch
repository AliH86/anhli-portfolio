+}
+body.theme-dandelion:not(.no-season) #about,
+body.theme-dandelion:not(.no-season) #music,
+body.theme-dandelion:not(.no-season) #videos,
+body.theme-dandelion:not(.no-season) #gallery,
+body.theme-dandelion:not(.no-season) #work,
+body.theme-dandelion:not(.no-season) #contact {
+  background:
+    radial-gradient(54% 34% at 86% 0%, rgba(255,247,210,0.045), transparent 68%),
