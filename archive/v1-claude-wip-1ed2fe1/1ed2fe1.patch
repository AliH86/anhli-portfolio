+}
+body:not(.no-season) .album-cover,
+body:not(.no-season) .g-item,
+body:not(.no-season) .vid-card,
+body:not(.no-season) .work-card,
+body:not(.no-season) .drawer-inner {
+  box-shadow:0 20px 64px rgba(0,0,0,0.34), 0 0 0 1px rgba(202,190,137,0.045);
+}
+body.theme-dandelion:not(.no-season) .marquee-wrap {
+  background:linear-gradient(180deg, rgba(20,45,24,0.72), rgba(9,8,14,0.78));
