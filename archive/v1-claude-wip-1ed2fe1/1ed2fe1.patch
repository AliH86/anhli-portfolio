+/* ════════════════ SKIN LAYER — "lớp áo" campaign ════════════════
+   BASE = khối :root ở trên (cứng, KHÔNG đụng khi làm campaign).
+   SKIN = một lớp ghi đè token màu + trang trí cho từng album / thông điệp.
+     • Bật:  document.documentElement.dataset.skin = 'ten-skin'   (hoặc thêm ?skin=ten-skin vào URL)
+     • Cởi:  delete document.documentElement.dataset.skin          → về base 100%
+   Khung / hoa văn của campaign vẽ trong .skin-decor (mặc định TRỐNG, không ảnh hưởng base).
+   Thêm album mới = copy khối ":root[data-skin='sample']" bên dưới, đổi tên + token. */
+.skin-decor{ position:fixed; inset:0; pointer-events:none; z-index:50; opacity:0; transition:opacity .6s ease; }
+:root[data-skin] .skin-decor{ opacity:1; }
+body.no-motion .skin-decor{ transition:none; }
+
+/* ---- SKIN MẪU 'sample' (xanh ngọc) — bằng chứng cơ chế chạy; copy để tạo skin album ----
+   Thử nhanh trong console:  document.documentElement.dataset.skin='sample'
+   Về cũ:  delete document.documentElement.dataset.skin */
+:root[data-skin="sample"]{
+  --amber:#6FB3A8; --amber2:#9AD3C9; --amber3:#C7EAE3;
+  --amber-rgb:111,179,168;
+  --glow:rgba(var(--amber-rgb),0.10);
+  --border2:rgba(var(--amber-rgb),0.20);
+}
+:root[data-skin="sample"] .skin-decor{ box-shadow: inset 0 0 0 6px rgba(var(--amber-rgb),0.18); }
 
